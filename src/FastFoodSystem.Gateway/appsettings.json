{
  "ReverseProxy": {
    "Routes": {
      "catalog-menu-items": {
        "ClusterId": "catalogCluster",
        "Match": {
          "Path": "/api/menu-items/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/menu-items/{**catch-all}"
          }
        ]
      },
      "ordering-orders": {
        "ClusterId": "orderingCluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/orders/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "catalogCluster": {
        "Destinations": {
          "catalogDestination": {
            "Address": "http://host.docker.internal:52548"
          }
        },
        "HttpRequest": {
          "Timeout": "30"
        }
      },
      "orderingCluster": {
        "Destinations": {
          "orderingDestination": {
            "Address": "http://host.docker.internal:52549"
          }
        },
        "HttpRequest": {
          "Timeout": "30"
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
